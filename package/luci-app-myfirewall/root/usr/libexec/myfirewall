#!/bin/sh

CONFIG_NAME="myfirewall"
NFT_FILE="${MYFIREWALL_NFT_FILE:-/etc/nftables.d/90-myfirewall.nft}"
CHAIN_NAME="myfirewall"
FW4_BIN="${MYFIREWALL_FW4_BIN:-/sbin/fw4}"
NFT_BIN="${MYFIREWALL_NFT_BIN:-nft}"
FUNCTIONS_LIB="${MYFIREWALL_FUNCTIONS_LIB:-/lib/functions.sh}"

. "$FUNCTIONS_LIB"

log() {
	echo "myfirewall: $*" >&2
}

safe_token() {
	case "$1" in
		''|*[!0-9A-Fa-f:./_-]*)
			return 1
			;;
	esac

	return 0
}

normalize_mac() {
	printf '%s' "$1" | tr '-' ':' | tr '[:lower:]' '[:upper:]'
}

valid_mac() {
	_mac="$(normalize_mac "$1")"
	printf '%s\n' "$_mac" | grep -Eq '^([0-9A-F]{2}:){5}[0-9A-F]{2}$'
}

valid_ip() {
	safe_token "$1" || return 1
	printf '%s\n' "$1" | grep -Eq '^[0-9A-Fa-f:.]+(/[0-9]{1,3})?$'
}

normalize_time() {
	_time="$1"

	case "$_time" in
		[0-2][0-9]:[0-5][0-9])
			_time="${_time}:00"
			;;
	esac

	printf '%s\n' "$_time"
}

valid_time() {
	printf '%s\n' "$1" | grep -Eq '^([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$'
}

each_config_value() {
	_each_section="$1"
	_each_option="$2"
	_each_callback="$3"

	config_get _each_length "$_each_section" "${_each_option}_LENGTH" ""
	if [ -n "$_each_length" ]; then
		config_list_foreach "$_each_section" "$_each_option" "$_each_callback"
	else
		config_get _each_value "$_each_section" "$_each_option" ""
		[ -n "$_each_value" ] && "$_each_callback" "$_each_value"
	fi
}

collect_mac() {
	_mac_count=$((_mac_count + 1))
	if ! valid_mac "$1"; then
		_mac_invalid=1
		return
	fi

	_normalized_mac="$(normalize_mac "$1")"
	_mac_values="${_mac_values}${_mac_values:+, }${_normalized_mac}"
}

collect_ip() {
	_ip_count=$((_ip_count + 1))
	if ! valid_ip "$1"; then
		_ip_invalid=1
		return
	fi

	case "$1" in
		*:*)
			_ip6_values="${_ip6_values}${_ip6_values:+, }$1"
			;;
		*)
			_ip4_values="${_ip4_values}${_ip4_values:+, }$1"
			;;
	esac
}

weekday_name() {
	case "$1" in
		Mon|Monday|1) echo "Monday" ;;
		Tue|Tuesday|2) echo "Tuesday" ;;
		Wed|Wednesday|3) echo "Wednesday" ;;
		Thu|Thursday|4) echo "Thursday" ;;
		Fri|Friday|5) echo "Friday" ;;
		Sat|Saturday|6) echo "Saturday" ;;
		Sun|Sunday|7) echo "Sunday" ;;
		*) return 1 ;;
	esac
}

build_weekday_match() {
	_day_match=""
	_day_list=""

	for _day in $1; do
		_day_name="$(weekday_name "$_day")" || return 1

		if [ -z "$_day_list" ]; then
			_day_list="$_day_name"
		else
			_day_list="${_day_list}, ${_day_name}"
		fi
	done

	[ -n "$_day_list" ] || return 1
	_day_match="meta day { ${_day_list} }"
}

emit_rule_line() {
	_start="$1"
	_stop="$2"
	_time_match=""

	if [ -n "$_start" ] && [ -n "$_stop" ]; then
		_time_match="meta hour \"${_start}\"-\"${_stop}\""
	fi

	printf '        %s%s counter %s' "$_base_match" "$_time_match" "$action"

	if [ -n "$_comment" ]; then
		printf ' comment "%s"' "$_comment"
	fi

	printf '\n'
	rule_count=$((rule_count + 1))
}

emit_time_rules() {
	if [ "$timed" -eq 1 ]; then
		if awk -v start="$start_time" -v stop="$stop_time" 'BEGIN { exit !(start <= stop) }'; then
			emit_rule_line "$start_time" "$stop_time"
		else
			emit_rule_line "00:00:00" "$stop_time"
			emit_rule_line "$start_time" "23:59:59"
		fi
	else
		emit_rule_line "" ""
	fi
}

emit_rule() {
	local section="$1"
	local enabled name match protocol action timed start_time stop_time weekdays
	local _mac_values _ip4_values _ip6_values _mac_count _ip_count
	local _mac_invalid _ip_invalid _mac_match

	config_get_bool enabled "$section" enabled 1
	[ "$enabled" -eq 1 ] || return 0

	config_get name "$section" name "未命名规则"
	config_get match "$section" match "both"
	config_get protocol "$section" protocol "tcp_udp"
	config_get action "$section" action "drop"
	config_get_bool timed "$section" timed 0
	config_get start_time "$section" start_time ""
	config_get stop_time "$section" stop_time ""
	config_get weekdays "$section" weekdays ""

	_mac_values=""
	_ip4_values=""
	_ip6_values=""
	_mac_count=0
	_ip_count=0
	_mac_invalid=0
	_ip_invalid=0

	case "$match" in
		mac)
			each_config_value "$section" src_mac collect_mac
			if [ "$_mac_count" -eq 0 ] || [ "$_mac_invalid" -eq 1 ]; then
				log "忽略规则 '$name'：MAC 地址无效或为空"
				return 0
			fi
			;;
		ip)
			each_config_value "$section" src_ip collect_ip
			if [ "$_ip_count" -eq 0 ] || [ "$_ip_invalid" -eq 1 ]; then
				log "忽略规则 '$name'：IP 地址无效或为空"
				return 0
			fi
			;;
		both)
			each_config_value "$section" src_mac collect_mac
			each_config_value "$section" src_ip collect_ip
			if [ "$_mac_count" -eq 0 ] || [ "$_mac_invalid" -eq 1 ] ||
			   [ "$_ip_count" -eq 0 ] || [ "$_ip_invalid" -eq 1 ]; then
				log "忽略规则 '$name'：需要同时填写有效的 MAC 和 IP 地址"
				return 0
			fi
			;;
		*)
			log "忽略规则 '$name'：未知匹配方式 '$match'"
			return 0
			;;
	esac

	case "$protocol" in
		tcp_udp|both)
			_proto_match="meta l4proto { tcp, udp }"
			;;
		tcp)
			_proto_match="meta l4proto tcp"
			;;
		udp)
			_proto_match="meta l4proto udp"
			;;
		*)
			log "忽略规则 '$name'：未知协议 '$protocol'"
			return 0
			;;
	esac

	case "$action" in
		drop|reject|accept)
			;;
		*)
			log "忽略规则 '$name'：未知动作 '$action'"
			return 0
			;;
	esac

	if [ -n "$weekdays" ]; then
		if ! build_weekday_match "$weekdays"; then
			log "忽略规则 '$name'：星期配置无效"
			return 0
		fi
	else
		_day_match=""
	fi

	_comment="$(printf '%s' "$name" | sed -e 's/"/ /g' -e 's/\\/ /g' | tr '\r\n' '  ')"

	if [ "$timed" -eq 1 ]; then
		start_time="$(normalize_time "$start_time")"
		stop_time="$(normalize_time "$stop_time")"

		if ! valid_time "$start_time" || ! valid_time "$stop_time"; then
			log "忽略规则 '$name'：开始和结束时间格式应为 HH:MM:SS"
			return 0
		fi
	fi

	_mac_match=""
	[ -z "$_mac_values" ] || _mac_match="ether saddr { ${_mac_values} }"

	if [ -n "$_ip4_values" ]; then
		_base_match="${_mac_match} ip saddr { ${_ip4_values} } fib daddr type != local ${_proto_match} ${_day_match}"
		emit_time_rules
	fi

	if [ -n "$_ip6_values" ]; then
		_base_match="${_mac_match} ip6 saddr { ${_ip6_values} } fib daddr type != local ${_proto_match} ${_day_match}"
		emit_time_rules
	fi

	if [ "$match" = "mac" ]; then
		_base_match="${_mac_match} fib daddr type != local ${_proto_match} ${_day_match}"
		emit_time_rules
	fi
}

generate_rules() {
	mkdir -p "$(dirname "$NFT_FILE")" || return 1

	tmp_file="${NFT_FILE}.tmp.$$"
	check_file="${NFT_FILE}.check.$$"
	trap 'rm -f "$tmp_file" "$check_file"' EXIT HUP INT TERM

	config_load "$CONFIG_NAME"
	config_get_bool global_enabled settings enabled 1

	if [ "$global_enabled" -ne 1 ]; then
		rm -f "$tmp_file" "$check_file"
		if [ -f "$NFT_FILE" ]; then
			rm -f "$NFT_FILE"
		fi
		trap - EXIT HUP INT TERM
		log "MyFirewall 已停用"
		return 0
	fi

	rule_count=0
	{
		printf 'chain %s {\n' "$CHAIN_NAME"
		printf '        type filter hook prerouting priority mangle - 20; policy accept;\n\n'
		config_foreach emit_rule rule
		printf '}\n'
	} > "$tmp_file" || return 1

	if [ "$rule_count" -eq 0 ]; then
		rm -f "$tmp_file" "$check_file" "$NFT_FILE"
		trap - EXIT HUP INT TERM
		log "没有启用的规则，已移除 MyFirewall nft 规则"
		return 0
	fi

	{
		printf 'table inet myfirewall_validate {\n'
		cat "$tmp_file"
		printf '}\n'
	} > "$check_file"

	if ! "$NFT_BIN" -c -f "$check_file" >/dev/null; then
		rm -f "$tmp_file" "$check_file"
		trap - EXIT HUP INT TERM
		log "nft 规则校验失败"
		return 1
	fi

	chmod 0644 "$tmp_file"
	mv -f "$tmp_file" "$NFT_FILE" || return 1
	rm -f "$check_file"
	trap - EXIT HUP INT TERM
	log "已生成 $rule_count 条 nft 规则"
	return 0
}

reload_firewall() {
	if [ ! -x "$FW4_BIN" ]; then
		log "找不到可执行的 fw4：$FW4_BIN"
		return 1
	fi

	"$FW4_BIN" reload >/dev/null || {
		log "重新加载 fw4 失败"
		return 1
	}
}

case "$1" in
	generate)
		generate_rules
		;;
	apply)
		generate_rules && reload_firewall
		;;
	*)
		echo "用法: $0 {generate|apply}" >&2
		exit 1
		;;
esac
